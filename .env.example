# Copy to .env and fill in as the weeks go on. Never commit .env.
ENVIRONMENT=development

# Used when running the API outside Docker. docker-compose overrides these.
DATABASE_URL=postgresql+psycopg://devassist:devassist@localhost:5432/devassist
REDIS_URL=redis://localhost:6379/0

# Embeddings. "ollama" (default) runs a free local model in Docker: no key, no rate limits.
# "voyage" uses the Voyage AI API instead and needs VOYAGE_API_KEY.
EMBEDDING_PROVIDER=ollama
OLLAMA_MODEL=qwen3-embedding:0.6b
VOYAGE_API_KEY=

# Answers to questions. "ollama" (default) runs a free local model in Docker: no key, no
# cost, code stays on your machine. "anthropic" uses Claude: better answers and citations,
# about $0.02 per question with Sonnet, and needs an API key with prepaid credits.
ANSWER_PROVIDER=ollama
OLLAMA_ANSWER_MODEL=qwen2.5-coder:3b
ANTHROPIC_API_KEY=
CLAUDE_ANSWER_MODEL=claude-sonnet-5-5
# low, medium or high: how much Claude thinks before answering. Higher is slower and costs more.
CLAUDE_ANSWER_EFFORT=low

# Pull request reviews. Optional: without a token GitHub allows 60 API requests an hour,
# enough for a few reviews. A free personal access token with no scopes raises it to 5,000.
GITHUB_TOKEN=

# Week 4, stage 2: the GitHub App that reviews new pull requests automatically
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
